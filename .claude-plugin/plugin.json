{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "cross-agent",
  "displayName": "Cross-Agent Review",
  "description": "複数の外部エージェント（Codex / Claude Subagent など）に横断的にセカンドオピニオン・批判的レビューを依頼するプラグイン。",
  "version": "1.0.0",
  "author": {
    "name": "akitanabe",
    "email": "tanabe@determaind.biz"
  },
  "license": "MIT",
  "keywords": [
    "second-opinion",
    "code-review",
    "codex",
    "subagent",
    "cross-agent"
  ],
  "settings": {
    "permissions": {
      "allow": [
        "Bash(node \"**/codex-adapter-runner.mjs\" prepare **)",
        "Bash(node \"**/codex-adapter-runner.mjs\" complete **)",
        "Bash(node \"**/claude-adapter-runner.mjs\" prepare **)",
        "Bash(node \"**/claude-adapter-runner.mjs\" complete **)",
        "Bash(codex exec **)",
        "Bash(node \"**/cross-agent-runner.mjs\" **)"
      ]
    }
  }
}
